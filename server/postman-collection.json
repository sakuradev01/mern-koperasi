{
	"info": {
		"_postman_id": "member-auth-collection",
		"name": "MERN Koperasi Complete API - Member & Admin",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"description": "Complete API collection for MERN Koperasi System with Product Upgrade support"
	},
	"item": [
		{
			"name": "Member Authentication (Magic Key)",
			"item": [
				{
					"name": "1. Generate Encrypted Payload",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set('encryptedPayload', response.data.encryptedPayload);",
									"    pm.collectionVariables.set('test_uuid', response.data.uuid);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"uuid\": \"JPSB37142\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/member-auth/generate-payload",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"member-auth",
								"generate-payload"
							]
						}
					}
				},
				{
					"name": "2. Get Member Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set('memberToken', response.data.token);",
									"    pm.collectionVariables.set('memberUuid', response.data.member.uuid);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "x-koperasi-auth",
								"value": "{{encryptedPayload}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/member-auth/token",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"member-auth",
								"token"
							]
						}
					}
				},
				{
					"name": "3. Access Member Dashboard",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{memberToken}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/members/dashboard/{{memberUuid}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"members",
								"dashboard",
								"{{memberUuid}}"
							]
						}
					}
				},
				{
					"name": "4. Get Proof File",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/member-auth/proof/{{proof_filename}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"member-auth",
								"proof",
								"{{proof_filename}}"
							]
						}
					}
				}
			]
		},
